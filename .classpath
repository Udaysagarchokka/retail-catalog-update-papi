<classpath>
	<classpathentry kind="con" path="org.mule.tooling.MULE_PROJECT_LIB"/>
	<classpathentry kind="con" path="MULE_LIB/org.mule.modules/mule-apikit-module/1.11.15"/>
	<classpathentry kind="con" path="MULE_LIB/org.mule.connectors/mule-file-connector/1.5.7"/>
	<classpathentry kind="con" path="MULE_LIB/com.mulesoft.munit/munit-tools/3.3.1"/>
